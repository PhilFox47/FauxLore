# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# IGDB_CLIENT_ID: Required for Video Game Database querying via IGDB API.
# IGDB_CLIENT_SECRET: Required for Video Game Database querying via IGDB API.
# The user needs to add both keys via Settings -> Environment Variables.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# HARDCOVER_API_KEY: Required for Book metadata querying via Hardcover.app API.
# The user needs to add this key via Settings -> Environment Variables.
HARDCOVER_API_KEY=

# TMDB_API_KEY: Required for Movie and Series querying via The Movie Database API.
# The user needs to add this key via Settings -> Environment Variables.
TMDB_API_KEY=

# PORT: The port the application binds to.
# This must remain 3000 in AI Studio environments, but can be changed for local clones.
PORT=3000

# VITE_HMR_PORT: The websocket port used for Vite's Hot Module Replacement during development.
# Defaults to 24678. You can override it here if port 24678 is in use locally.
VITE_HMR_PORT=24678
